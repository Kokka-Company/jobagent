# Copy to .env and fill in. .env is gitignored.

# LLM backend: "cli" (default) routes completions through the Claude Code CLI
# (`claude -p`), reusing this machine's existing Claude auth — no key needed.
# Set to "api" to call the Anthropic API directly (then ANTHROPIC_API_KEY is required).
JOBAGENT_LLM_BACKEND=cli

# Only needed when JOBAGENT_LLM_BACKEND=api:
# ANTHROPIC_API_KEY=sk-ant-...

# CLI backend tuning (optional):
# JOBAGENT_CLAUDE_PATH=/home/you/.local/bin/claude   # override auto-detection
# JOBAGENT_CLAUDE_TIMEOUT=180                          # per-call timeout (seconds)

# Module C (outreach) — optional until Phase 3
HUNTER_API_KEY=

# Model overrides (optional; defaults set in config.py)
JOBAGENT_MODEL_TAILOR=claude-opus-4-8
JOBAGENT_MODEL_PARSE=claude-haiku-4-5-20251001
JOBAGENT_MODEL_EVALUATE=claude-sonnet-5-5

# Application filler behavior
JOBAGENT_AUTO_SUBMIT=false

# Browser: auto-detected (~/.local/chrome or system). Override if needed.
# JOBAGENT_CHROME_PATH=/home/you/.local/chrome/opt/google/chrome/google-chrome
